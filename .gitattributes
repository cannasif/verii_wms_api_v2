# Detect text files without rewriting every existing source file.
* text=auto

# Linux/Jenkins entrypoints must use LF.
*.sh text eol=lf
Dockerfile text eol=lf
Jenkinsfile text eol=lf

# Windows command files require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must not be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pfx binary
*.p12 binary
